    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@keystone-6/auth": "^10.0.2",
    "@keystone-6/core": "^8.0.4",
    "@keystone-6/fields-document": "^11.0.2",
    "@prisma/adapter-better-sqlite3": "^7.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^12.6.0",
    "dotenv": "^17.4.2",
    "get-random-values": "^5.0.1",
    "next": "^16.2.10",
    "prisma": "^7.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
