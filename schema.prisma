  aboutImages           String            @default("")
  interestsTitle        String            @default("")
  interestsDescription  String            @default("")
  interestsAreas        String            @default("")
  skills                Skill[]           @relation("Skill_profile")
  experiences           Experience[]      @relation("Experience_profile")
  educations            Education[]       @relation("Education_profile")
  certificates          Certificate[]     @relation("Certificate_profile")
  articles              Article[]         @relation("Article_profile")
  hireMe                HireMe[]          @relation("HireMe_profile")
