  projectCategories     ProjectCategory[] @relation("ProjectCategory_profile")
  projects              Project[]         @relation("Project_profile")
  socialLinks           SocialLink[]      @relation("SocialLink_profile")
  personalInfos         PersonalInfo[]    @relation("PersonalInfo_profile")
  freelanceLinks        FreelanceLink[]   @relation("FreelanceLink_profile")
  contactInfos          ContactInfo[]     @relation("ContactInfo_profile")
  copyright             Copyright?        @relation("Copyright_profile")
}

